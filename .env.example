# Lumbrera Environment Configuration
# Copy this file to .env and update with your values

# ==========================================
# AWS Configuration
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=DUMMYIDEXAMPLE
AWS_SECRET_ACCESS_KEY=DUMMYEXAMPLEKEY

# ==========================================
# DynamoDB
# ==========================================
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_NAME=lumbrera-local

# ==========================================
# Auth0 Configuration
# Get these from your Auth0 dashboard
# ==========================================
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.lumbrera.app

# Auth0 Connections
AUTH0_GOOGLE_CONNECTION=google-oauth2
AUTH0_FACEBOOK_CONNECTION=facebook

# ==========================================
# Application Configuration
# ==========================================
STAGE=local
API_BASE_URL=http://localhost:3000/v1
API_VERSION=v1

# ==========================================
# Mobile App (Flutter)
# ==========================================
FLUTTER_APP_NAME=Lumbrera
FLUTTER_BUNDLE_ID=com.lumbrera.app
FLUTTER_IOS_BUNDLE_ID=com.lumbrera.app.ios
FLUTTER_ANDROID_PACKAGE=com.lumbrera.app.android

# ==========================================
# Feature Flags
# ==========================================
ENABLE_DEBUG_LOGGING=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# ==========================================
# Gamification Settings
# ==========================================
DEFAULT_DAILY_GOAL_XP=50
MAX_STREAK_FREEZE=2
LEVEL_UP_XP_BASE=100
LEVEL_UP_XP_MULTIPLIER=1.5

# ==========================================
# Database Settings
# ==========================================
# DynamoDB capacity (for non-local environments)
DYNAMODB_READ_CAPACITY=5
DYNAMODB_WRITE_CAPACITY=5
DYNAMODB_ON_DEMAND=false

# ==========================================
# Monitoring & Logging
# ==========================================
LOG_LEVEL=info
ENABLE_XRAY_TRACING=false
SENTRY_DSN=

# ==========================================
# Testing
# ==========================================
TEST_DYNAMODB_ENDPOINT=http://localhost:8002
TEST_TABLE_NAME=lumbrera-test
